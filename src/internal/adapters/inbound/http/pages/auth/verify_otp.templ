package pages

import "github.com/a-h/templ"

// verify_otp.templ - Branded verify OTP page for an app (served by CAS)
// Compiled by: templ generate -> verify_otp.go
templ VerifyOTP(data AuthData) {
	Layout(data.PageTitle, {
		<div class="container">
			<div class="card">
				<div class="brand">
					@if data.AuthPageLogo != "" {
						<img src={ data.AuthPageLogo } alt="Logo" />
					}
					<div class="name" style="color: { data.AuthPagePrimaryColor }">{ data.App.Name }</div>
				</div>
				<h1>Verify your identity</h1>
				<p style="text-align:center; color:#6b7280; margin-bottom:24px;">A code was sent to your { data.App.OtpType }.</p>
				@if data.Error != "" {
					<div class="error show">{ data.Error }</div>
				}
				<form method="POST" action="/auth/verify-otp">
					<input type="hidden" name="app_id" value={ data.AppID } />
					<input type="hidden" name="user_id" value={ data.App.ID.String() } />
					<input type="hidden" name="otp_type" value={ data.App.OtpType } />
					<input type="hidden" name="otp_hash" value={ data.OtpHash } />
					<input type="hidden" name="csrf_token" value={ data.CsrfToken } />
					<div class="form-group">
						<label for="otp_code">Verification Code</label>
						<input type="text" id="otp_code" name="otp_code" placeholder="12345" maxlength="5" required />
					</div>
					<button type="submit">Verify</button>
				</form>
				<div class="footer">
					Didn't receive a code? <a href="/auth/login?app_id={ data.AppID }">Try signing in again</a>
				</div>
			</div>
		</div>
	})
}
