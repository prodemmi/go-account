package pages

import "github.com/a-h/templ"

// signup.templ - Branded signup page for an app (served by CAS)
// Compiled by: templ generate -> signup.go
templ Signup(data AuthData) {
	Layout(data.PageTitle, {
		<div class="container">
			<div class="card">
				<div class="brand">
					@if data.AuthPageLogo != "" {
						<img src={ data.AuthPageLogo } alt="Logo" />
					}
					<div class="name" style="color: { data.AuthPagePrimaryColor }">{ data.App.Name }</div>
				</div>
				<h1>Create an account with { data.App.Name }</h1>
				@if data.Error != "" {
					<div class="error show">{ data.Error }</div>
				}
				@if data.Success != "" {
					<div class="success show">{ data.Success }</div>
				}
				<form method="POST" action="/auth/signup">
					<input type="hidden" name="app_id" value={ data.AppID } />
					<input type="hidden" name="csrf_token" value={ data.CsrfToken } />
					<div class="form-group">
						<label for="first_name">First Name</label>
						<input type="text" id="first_name" name="first_name" placeholder="Emad" required />
					</div>
					<div class="form-group">
						<label for="last_name">Last Name</label>
						<input type="text" id="last_name" name="last_name" placeholder="Malekpour" required />
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" placeholder="you@example.com" required />
					</div>
					<div class="form-group">
						<label for="mobile">Mobile</label>
						<input type="tel" id="mobile" name="mobile" placeholder="+989130243519" />
					</div>
					<div class="form-group">
						<label for="password">Password</label>
						<input type="password" id="password" name="password" placeholder="••••••••" required />
					</div>
					<button type="submit">Create account</button>
				</form>
				<div class="footer">
					Already have an account? <a href="/auth/login?app_id={ data.AppID }">Sign in</a>
				</div>
			</div>
		</div>
	})
}
