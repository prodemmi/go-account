package pages

import "github.com/a-h/templ"

// admin/app_form.templ - Admin app create/edit form
// Compiled by: templ generate -> admin/app_form.go
templ AppForm(app AppFormData, isEdit bool) {
	title := "New App"
	@if isEdit {
		title = "Edit App"
	}
	action := "/admin/apps"
	@if isEdit {
		action = "/admin/apps/" + app.ID + "/update"
	}
	AdminLayout(title, {
		<div class="header">
			<h1>{ title }</h1>
			<a href="/admin/apps" class="btn-secondary">← Back</a>
		</div>
		<div class="form-card">
			<form method="POST" action={ action }>
				<input type="hidden" name="id" value={ app.ID } />
				<div class="form-group">
					<label for="name">App Name</label>
					<input type="text" id="name" name="name" value={ app.Name } placeholder="Fotomi" required />
				</div>
				<div class="form-group">
					<label for="url">App URL</label>
					<input type="text" id="url" name="url" value={ app.Url } placeholder="https://fotomi.net/" required />
				</div>
				<div class="form-group">
					<label for="auth_url">Auth Callback URL</label>
					<input type="text" id="auth_url" name="auth_url" value={ app.AuthUrl } placeholder="https://fotomi.net/auth/callback" required />
				</div>
				<div class="form-group">
					<label for="otp_type">OTP Type</label>
					<input type="text" id="otp_type" name="otp_type" value={ app.OtpType } placeholder="email" />
				</div>
				<div class="form-group">
					<label for="session_timeout">Session Timeout (seconds)</label>
					<input type="number" id="session_timeout" name="session_timeout" value={ app.SessionTimeout } placeholder="3600" />
				</div>
				<hr style="margin:24px 0; border:none; border-top:1px solid #e2e8f0;" />
				<h3 style="font-size:1rem; margin-bottom:12px; color:#475569;">Auth Page Customization</h3>
				<div class="checkbox-group">
					<input type="checkbox" id="auth_page_enabled" name="auth_page_enabled" value="true" @if app.AuthPageEnabled { checked } />
					<label for="auth_page_enabled">Enable custom auth page</label>
				</div>
				<div class="form-group">
					<label for="auth_page_url">Custom Auth Page URL</label>
					<input type="text" id="auth_page_url" name="auth_page_url" value={ app.AuthPageURL } placeholder="https://fotomi.net/auth/login" />
				</div>
				<div class="form-group">
					<label for="auth_page_logo">Logo URL</label>
					<input type="text" id="auth_page_logo" name="auth_page_logo" value={ app.AuthPageLogo } placeholder="https://fotomi.net/logo.png" />
				</div>
				<div class="form-group">
					<label for="auth_page_primary_color">Primary Color</label>
					<input type="color" id="auth_page_primary_color" name="auth_page_primary_color" value={ app.AuthPagePrimaryColor } />
				</div>
				<div class="form-group">
					<label for="auth_page_template">Template</label>
					<input type="text" id="auth_page_template" name="auth_page_template" value={ app.AuthPageTemplate } placeholder="default" />
				</div>
				<button type="submit" class="btn">Save App</button>
			</form>
		</div>
	})
}

type AppFormData struct {
	ID                    string
	Name                  string
	Url                   string
	AuthUrl               string
	OtpType               string
	SessionTimeout        int
	AuthPageURL           string
	AuthPageTemplate      string
	AuthPageLogo          string
	AuthPagePrimaryColor  string
	AuthPageEnabled       bool
}
