package pages

import "github.com/a-h/templ"

// admin/layout.templ - Base layout for the admin panel
// Compiled by: templ generate -> admin/layout.go
templ AdminLayout(title string, content templ.Node) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - CAS Admin</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="/static/css/admin.css" />
	</head>
	<body>
		<aside class="sidebar">
			<h2>CAS Admin</h2>
			<nav>
				<a href="/admin/apps" class="active">Apps</a>
				<a href="/admin/sessions">Sessions</a>
			</nav>
		</aside>
		<main class="main">
			{ content }
		</main>
	</body>
	</html>
}
