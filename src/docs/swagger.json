{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/v1/auth/check": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Check CAS session (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Location",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/auth/logout": {
            "delete": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Location",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/v1/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Current session (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "session token",
                        "name": "API-TOKEN",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/auth/send-otp": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Send OTP (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.sendOTPBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/auth/verify-otp": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Verify OTP (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.verifyOTPBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/auth/verify-ott": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Verify OTT (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.verifyOTTBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/user/sessions": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Sessions"
                ],
                "summary": "List my sessions (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "app id",
                        "name": "APP-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Sessions"
                ],
                "summary": "Terminate sessions in batch (CAS)",
                "parameters": [
                    {
                        "description": "session ids",
                        "name": "payload",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/handlers.terminateSessionsBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/v1/user/sessions/{id}": {
            "delete": {
                "tags": [
                    "Sessions"
                ],
                "summary": "Terminate a session (CAS)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "session id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.sendOTPBody": {
            "type": "object",
            "required": [
                "identifier"
            ],
            "properties": {
                "identifier": {
                    "type": "string",
                    "example": "+989130243519"
                }
            }
        },
        "handlers.terminateSessionsBody": {
            "type": "object",
            "required": [
                "ids"
            ],
            "properties": {
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "14a03569-d26b-4496-92e5-dfe8cb1855fe"
                    ]
                }
            }
        },
        "handlers.verifyOTPBody": {
            "type": "object",
            "required": [
                "identifier",
                "otp_code",
                "otp_hash"
            ],
            "properties": {
                "identifier": {
                    "type": "string",
                    "example": "+989130243519"
                },
                "otp_code": {
                    "type": "string",
                    "example": "12345"
                },
                "otp_hash": {
                    "type": "string",
                    "example": "fabecfb8ad5895a6a6309e5a7d1b5c48601d1f9e"
                }
            }
        },
        "handlers.verifyOTTBody": {
            "type": "object",
            "required": [
                "ott"
            ],
            "properties": {
                "ott": {
                    "type": "string",
                    "example": "9f2c..."
                }
            }
        }
    }
}